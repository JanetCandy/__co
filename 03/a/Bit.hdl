// File name: projects/03/a/Bit.hdl

/**
 * 1-bit register:
 * If load[t] == 1 then out[t+1] = in[t]
 *                 else out does not change (out[t+1] = out[t])
 */

CHIP Bit {
    IN in, load;
    OUT out;

    PARTS:
    // 1. 根據 load 決定選擇「新輸入 in」還是 「舊輸出 feedback」
    Max(a=feedback, b=in, sel=load, out=muxOut);

    // 2. 將 Mux 選擇結果送入 DFF， 並同時輸出至 out 與內部反饋 feedback
    DFF(in=muxOut, out=out, out=feedback);
}
