// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    // 1. 計算自增值 out + 1
    Inc16(in=feedback, out=pcInc);

    // 2. 處理 inc (優先度最低)：決定是維持原值還是 +1
    Mux16(a=feedback, b=pcInc, sel=inc, out=outInc);

    // 3. 處理 load：若 load == 1，覆蓋為外部輸入 in
    Mux16(a=outInc, b=in, sel=load, out=outLoad);

    // 4. 處理 reset (優先度最高)：若 reset == 1，強制的歸零
    Mux16(a=outLoad, b=false, sel=reset, out=outReset);

    // 5. 鎖存狀態並輸出 (Register 的 load 永遠設為 true)
    Register(in=outReset, load=true, out=out, out=feedback);
}
